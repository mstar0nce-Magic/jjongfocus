{
  "id": "./",
  "name": "쫑글킵",
  "short_name": "쫑글킵",
  "description": "Google Keep에 모은 메모와 캡처를 정리하고 오늘의 행동으로 바꾸는 심플 PWA",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7f3",
  "theme_color": "#234734",
  "icons": [
    {"src":"icons/icon-192.png","sizes":"192x192","type":"image/png"},
    {"src":"icons/icon-512.png","sizes":"512x512","type":"image/png"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {"name":"files","accept":["image/*"]}
      ]
    }
  }
}